# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# Port the server listens on locally (Render/etc. set this automatically in prod)
PORT=3000

# Shared secret required in the "x-admin-key" header to add/edit/delete projects
ADMIN_KEY=choose-a-long-random-string-here
